FLASK_DEBUG=true
SECRET_KEY=replace-this-for-shared-or-production-environments
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_FOLDER=uploads
REPORT_FOLDER=reports/generated
CVE_DATA_PATH=../data/training/cve_instruction_train.jsonl
MAX_FILE_SIZE_MB=5

# Optional OpenAI-compatible Qwen endpoint. The baseline works without it.
ENABLE_QWEN=false
QWEN_API_URL=http://127.0.0.1:8000/v1/chat/completions
MODEL_NAME=qwen2.5-0.5b-instruct
QWEN_TIMEOUT_SECONDS=90
